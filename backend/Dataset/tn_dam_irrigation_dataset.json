  "metadata": {
    "title": "Tamil Nadu Dam Irrigation Dataset",
    "description": "Dataset mapping dams to beneficiary districts and irrigation zones. Used to identify relevant dam for a farmer based on their district (derived from pincode).",
    "usage": "1. Get pincode from farmer. 2. Resolve pincode to district. 3. Match district to dam(s). 4. Return dam info and irrigation guidance.",
    "version": "1.0",
    "state": "Tamil Nadu, India"
  },

